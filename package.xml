<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>csen934_project_pkg</name>
  <version>0.1.0</version>
  <description>CSEN934 Milestone 01: Webots odometry, Ackermann control, noisy odometry, EKF localization and SLAM integration.</description>
  <maintainer email="altac9275928@gmail.com">student</maintainer>
  <license>Apache-2.0</license>

  <!-- Core runtime -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Launch, visualisation, recording, analysis -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_plot</exec_depend>
  <exec_depend>rqt_graph</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <!-- SLAM stack (apt-installable). LIO-SAM is built from source, see README. -->
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
